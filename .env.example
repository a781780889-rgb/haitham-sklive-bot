# متغيّرات البيئة — انسخ هذا الملف إلى .env (محلياً) أو
# أضف القيم في Railway → Service → Variables
# ════════════════════════════════════════════════════════════

# 🤖 توكن البوت من @BotFather (إجباري)
BOT_TOKEN=ضع_توكن_البوت_هنا

# 👤 معرّفات الأدمن (مفصولة بفاصلة) — جيب معرّفك من @userinfobot
ADMIN_IDS=8436565004

# 🔐 كلمة سر لوحة الأدمن
ADMIN_PASS=Adm!n@2026#Secure

# 💳 معلومات الدفع
IBAN=SA00 0000 0000 0000 0000 0000
PAYMENT_NAME=اسم صاحب الحساب
STC_NUMBER=05xxxxxxxx

# 🗄️ قاعدة البيانات (Railway يعبّيها تلقائياً عند ربط PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 🌐 المنفذ (Railway يعبّيه تلقائياً — لا تعدّله)
# PORT=5000
